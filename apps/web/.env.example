# Copiez ce fichier en .env.local et remplissez les valeurs.
# Toutes les variables ci-dessous (sauf la section Sentry) sont requises —
# voir lib/env.ts, qui valide process.env au démarrage et fait échouer le
# boot si l'une d'elles manque.

# --- Supabase (Postgres + Auth + Storage) ---
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Deux endpoints Stripe pointent sur la même URL /api/webhooks/stripe :
# « Votre compte » (événements de la plateforme) et « Comptes connectés »
# (charge directe : paiements, remboursements, litiges, account.updated des
# opérateurs). Chacun a son secret de signature whsec_…
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- Twilio (WhatsApp / SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# --- Resend (email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Sous-domaine des boutiques clients (store.linktrip.co/{slug}/{code}).
# Facultative : laissée vide, les boutiques se servent depuis
# NEXT_PUBLIC_APP_URL sur /s/{slug}/{code}, ce qui est le cas en local.
NEXT_PUBLIC_STORE_URL=
# Secret partagé avec les crons Vercel (api/cron/automations, api/cron/gdpr-purge) — 20 caractères minimum.
CRON_SECRET=

# --- Sentry (optionnel — l'app démarre sans, Sentry reste inerte) ---
# DSN utilisé côté client, serveur et edge (voir sentry.*.config.ts).
NEXT_PUBLIC_SENTRY_DSN=
# Variables de build, pour l'upload des source maps uniquement — absentes = upload ignoré, le build réussit quand même.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Stockage des fichiers : Cloudflare R2 (lib/storage.ts). Tableau de bord Cloudflare, R2 :
# l'Account ID est affiché sur la page R2, la clé se crée dans « Manage R2 API Tokens »
# (droits Object Read & Write sur les deux buckets).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_ORIGINALS=originals
R2_BUCKET_PREVIEWS=previews
# Domaine public rattaché au bucket previews (Custom Domains), sans / final.
R2_PREVIEWS_PUBLIC_URL=https://media.linktrip.co
# Lue seulement par setup:storage (règle CORS du bucket originals), séparées par des virgules.
R2_CORS_ORIGINS=https://linktrip.co,http://localhost:3000
# Plafond total de stockage en Go : garde Linktrip dans l'offre gratuite de R2 (10 Go). Défaut 9.
# STORAGE_QUOTA_GB=9
# Facultatif : plafond par vidéo déposée, en Mo. Défaut 500.
# NEXT_PUBLIC_MAX_VIDEO_MB=500
