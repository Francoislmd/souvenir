# Copiez ce fichier en .env.local et remplissez les valeurs.
# Toutes les variables ci-dessous (sauf la section Sentry) sont requises —
# voir lib/env.ts, qui valide process.env au démarrage et fait échouer le
# boot si l'une d'elles manque.

# --- Supabase (Postgres + Auth + Storage) ---
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# TODO(françois) : STRIPE_CONNECT_WEBHOOK_SECRET était présent dans un
# .env.local existant mais n'est référencé nulle part dans lib/env.ts ni
# dans le code — account.updated est déjà traité dans le webhook principal
# via STRIPE_WEBHOOK_SECRET. À confirmer si c'est un reliquat à supprimer
# ou s'il manque un endpoint Connect séparé dans Stripe.
# STRIPE_CONNECT_WEBHOOK_SECRET=

# --- Twilio (WhatsApp / SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# --- Resend (email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secret partagé avec les crons Vercel (api/cron/automations, api/cron/gdpr-purge) — 20 caractères minimum.
CRON_SECRET=

# --- Sentry (optionnel — l'app démarre sans, Sentry reste inerte) ---
# DSN utilisé côté client, serveur et edge (voir sentry.*.config.ts).
NEXT_PUBLIC_SENTRY_DSN=
# Variables de build, pour l'upload des source maps uniquement — absentes = upload ignoré, le build réussit quand même.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
