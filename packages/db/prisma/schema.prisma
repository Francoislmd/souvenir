generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Operator {
  id         String  @id @default(cuid())
  name       String
  slug       String  @unique
  logoUrl    String?
  brandColor String  @default("#FF5A1F") // one of the 7 Linktrip swatches; drives boutique --op only

  stripeAccountId String?
  stripeOnboarded Boolean @default(false)

  pricePhotoCents Int     @default(800)
  priceAllCents   Int     @default(3900) // "Toutes vos photos" — aussi "Tout le créneau" en mode GROUPE
  freeCount       Int     @default(2)
  feePercent      Int     @default(20)
  packOnly        Boolean @default(false) // true = le client ne peut acheter que le pack complet, pas photo par photo

  // { resendUnopened, reducedPriceOffer, reviewRequest, referral } — referral always false, "bientôt"
  automations Json @default("{\"resendUnopened\":true,\"reducedPriceOffer\":true,\"reviewRequest\":true,\"referral\":false}")

  googleReviewUrl String?
  whatsappNumber  String?
  activities      String[] @default([]) // ids @souvenir/web:lib/onboarding/activities.ts — choisis à l'inscription, modifiables en réglages

  // Un seul lien de groupe par opérateur, réutilisé par toutes ses sorties
  // GROUPE — le client y choisit son jour (Sortie) puis son créneau (Slot).
  // Généré une fois, à la création de la première sortie GROUPE.
  shareToken String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  sorties Sortie[]
  events  Event[]
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  role       Role     @default(MONITEUR) // kept for future use; no longer gates the 3-tab nav
  operatorId String
  createdAt  DateTime @default(now())

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId])
}

enum Role {
  ADMIN
  MONITEUR
}

model Sortie {
  id         String       @id @default(cuid())
  operatorId String
  activity   String
  place      String?
  startsAt   DateTime
  seats      Int          @default(8)
  guide      String?
  status     SortieStatus @default(UPCOMING) // UPCOMING -> SORTED -> SENT; "today" is computed from startsAt, never stored
  createdAt  DateTime     @default(now())

  mode    SortieMode @default(INDIVIDUEL)
  purgeAt DateTime? // GROUPE uniquement — fixé à la publication (startsAt + 90j)

  operator       Operator        @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  participants   Participant[]
  photos         Photo[]
  slots          Slot[]
  processingJobs ProcessingJob[]

  @@index([operatorId])
  @@index([operatorId, startsAt])
  @@index([purgeAt])
}

enum SortieStatus {
  UPCOMING
  SORTED
  SENT
}

enum SortieMode {
  INDIVIDUEL
  GROUPE
}

// Mode GROUPE uniquement — un créneau détecté par regroupement EXIF (ou par
// repli si l'horodatage manque), cf. apps/web/lib/cluster.ts. Chaque
// acheteur devient un Participant rattaché au slot plutôt qu'à des photos
// possédées en propre.
model Slot {
  id           String   @id @default(cuid())
  sortieId     String
  label        String // "11 h 00"
  startsAt     DateTime // début du créneau (EXIF, ou réparti si repli)
  guide        String? // repris de sortie.guide par défaut
  coverPhotoId String?  @unique
  createdAt    DateTime @default(now())

  sortie       Sortie        @relation(fields: [sortieId], references: [id], onDelete: Cascade)
  photos       Photo[]       @relation("SlotPhotos")
  cover        Photo?        @relation("SlotCover", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  participants Participant[]

  @@index([sortieId])
}

model Participant {
  id       String  @id @default(cuid())
  sortieId String
  slotId   String? // mode GROUPE uniquement — créé au paiement, jamais par l'opérateur
  name     String
  contact  String // email OR phone, mandatory — cannot create without one
  channel  Channel // deriveChannel(contact)
  token    String  @unique // /g/{token} — the only secret, must be non-guessable

  consentAt DateTime  @default(now())
  deleteAt  DateTime // consentAt + 90d, RGPD purge cron target
  deletedAt DateTime?

  sentAt                DateTime?
  openedAt              DateTime?
  remindedAt            DateTime? // +2h resend idempotency
  reducedOfferSentAt    DateTime? // +24h offer idempotency
  reducedOfferExpiresAt DateTime? // offer valid 48h, read by quote()
  reviewRequestSentAt   DateTime? // post-purchase idempotency
  unsubscribedAt        DateTime? // coupe les emails 2/3/5 (marketing) — jamais 1/4 (transactionnels)

  createdAt DateTime @default(now())

  sortie Sortie  @relation(fields: [sortieId], references: [id], onDelete: Cascade)
  slot   Slot?   @relation(fields: [slotId], references: [id], onDelete: SetNull)
  order  Order?
  photos Photo[] @relation("PhotoOwner")

  @@index([sortieId])
  @@index([deleteAt])
  @@index([slotId])
}

enum Channel {
  EMAIL
  WHATSAPP
}

model Photo {
  id              String      @id @default(cuid())
  sortieId        String
  ownerId         String? // null = common photo, visible to every participant of the sortie (mode INDIVIDUEL)
  slotId          String? // mode GROUPE — créneau détecté par clustering EXIF
  hiddenAt        DateTime? // demande de retrait (mode GROUPE) — masquage immédiat, partout, sans justification
  originalKey     String
  previewKey      String?
  thumbKey        String?
  blurKey         String? // aperçu flouté généré côté serveur (JPEG) — jamais de CSS filter:blur, ça ne s'affiche pas dans les emails
  blurEmailKey    String? // même principe, flou un cran plus fort — les emails n'ont pas le cadenas/contexte visuel de la galerie
  groupPreviewKey String? // mode GROUPE uniquement — aperçu filigrané (motif répété), servi non floué avant paiement (lib/group-watermark.ts)
  takenAt         DateTime? // horodatage EXIF (DateTimeOriginal) lu à la publication d'une sortie GROUPE ; absent en mode INDIVIDUEL
  isVideo         Boolean     @default(false)
  isFreeSample    Boolean     @default(false) // INDIVIDUEL uniquement : échantillon offert (lib/assign.ts) — plus utilisé en mode GROUPE
  status          PhotoStatus @default(UPLOADED)
  createdAt       DateTime    @default(now())

  sortie  Sortie          @relation(fields: [sortieId], references: [id], onDelete: Cascade)
  owner   Participant?    @relation("PhotoOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  slot    Slot?           @relation("SlotPhotos", fields: [slotId], references: [id], onDelete: SetNull)
  coverOf Slot?           @relation("SlotCover")
  jobs    ProcessingJob[]

  @@index([sortieId])
  @@index([ownerId])
  @@index([slotId])
}

enum PhotoStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

model Order {
  id            String    @id @default(cuid())
  participantId String    @unique
  photoIds      String[]
  amountCents   Int
  feeCents      Int
  stripePi      String?   @unique
  status        String    @default("pending") // pending | succeeded | failed
  paidAt        DateTime?
  createdAt     DateTime  @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model ProcessingJob {
  id        String    @id @default(cuid())
  photoId   String? // "preview" jobs — one photo
  sortieId  String? // "publish_group" jobs — one GROUPE sortie, clusters its whole photo batch
  kind      String // "preview" | "publish_group"
  status    String    @default("pending")
  attempts  Int       @default(0)
  lockedAt  DateTime?
  createdAt DateTime  @default(now())

  photo  Photo?  @relation(fields: [photoId], references: [id], onDelete: Cascade)
  sortie Sortie? @relation(fields: [sortieId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([photoId])
  @@index([sortieId])
}

model Event {
  id            String   @id @default(cuid())
  operatorId    String
  participantId String?
  name          String
  meta          Json?
  createdAt     DateTime @default(now())

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId])
  @@index([participantId])
  @@index([name])
}

// Limitation de débit sur la connexion et la demande de réinitialisation —
// une ligne par tentative, comptée sur une fenêtre glissante. Pas de Redis :
// même logique "table Postgres" que ProcessingJob (cf. CLAUDE.md §2.3).
model AuthAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
